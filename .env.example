# Clash of Clans API token from https://developer.clashofclans.com/#/account
# Keys are bound to the IP address you created them for. If requests start
# returning 403 accessDenied, your IP changed — mint a new key for the new IP.
COC_API_TOKEN=

# Optional
PORT=8787
# Seconds to cache successful API responses in memory (0 disables caching)
CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# SQLite file holding users and sessions. The directory is created if missing.
# On a host this must point at a persistent volume, or every restart wipes the
# accounts. Defaults to ./data/coc.db.
DATABASE_PATH=./data/coc.db

# First-boot admin. Used ONLY when the users table is empty, so a restart can
# never reset a password that has since been changed. There is no signup form:
# after the first admin exists, accounts are created from the admin panel.
# Set both, start the server once, then remove ADMIN_PASSWORD from the
# environment. Minimum 12 characters. With these unset and no users, the app
# refuses to invent a default and logs that nobody can sign in.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Send the session cookie with the Secure flag. Implied by NODE_ENV=production;
# set it to true if you terminate HTTPS but do not set NODE_ENV. Leave unset for
# local http development, where a Secure cookie would never be sent back.
COOKIE_SECURE=

# Set to `production` on a host: it turns on the Secure cookie flag.
NODE_ENV=
