# Clash of Clans API token from https://developer.clashofclans.com/#/account
# Keys are bound to the IP address you created them for. If requests start
# returning 403 accessDenied, your IP changed — mint a new key for the new IP.
COC_API_TOKEN=

# Optional
PORT=8787
# Seconds to cache successful API responses in memory (0 disables caching)
CACHE_TTL_SECONDS=60

# Contact string put in the User-Agent by `npm run assets:wiki`, which fetches unit
# art from clashofclans.fandom.com. MediaWiki's UA policy wants a way to reach
# whoever is running the tool. Script-time only; the server never reads this.
# WIKI_CONTACT=you@example.com

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# SQLite file holding users, sessions, and the shared saved clans and owners.
# The directory is created if missing. On a host this must point at a persistent
# volume, or every restart wipes the accounts. Defaults to ./data/coc.db.
# Schema changes are applied on boot, in order, tracked by PRAGMA user_version.
DATABASE_PATH=./data/coc.db

# The login credential is an EMAIL address (it used to be a username).
#
# ADMIN_EMAIL does two jobs, and both are idempotent:
#
#  1. On an empty users table it creates the first admin, together with
#     ADMIN_PASSWORD. Set both, start the server once, then remove
#     ADMIN_PASSWORD from the environment. Minimum 12 characters. There is no
#     signup form: after the first admin exists, accounts are created from the
#     admin panel. With these unset and no users, the app refuses to invent a
#     default and logs that nobody can sign in.
#
#  2. On a database that predates email — where the migration left the oldest
#     admin with a username but no address — it fills that address in WITHOUT
#     touching the password. This is the escape hatch that stops the username
#     change locking you out of your own app: set it, restart once, then sign in
#     with that address and the password you already had. ADMIN_PASSWORD is
#     ignored on this path, so it can never reset a password you have changed.
#
# Once every account has an address, both jobs are no-ops and the variable can
# be removed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Display name for the first admin only, and only when it is being created.
# Defaults to the part of ADMIN_EMAIL before the @. Never a credential, and
# never overwrites the name of an account that already exists.
ADMIN_DISPLAY_NAME=

# Send the session cookie with the Secure flag. Implied by NODE_ENV=production;
# set it to true if you terminate HTTPS but do not set NODE_ENV. Leave unset for
# local http development, where a Secure cookie would never be sent back.
COOKIE_SECURE=

# Set to `production` on a host: it turns on the Secure cookie flag.
NODE_ENV=
