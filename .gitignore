node_modules/
dist/
# Vendored Supercell icon art — theirs, not ours to redistribute, and keeping it out
# of the repo is a licensing decision rather than housekeeping. Regenerate with
# `npm run assets:coc` (league + label icons, from the API) and `npm run assets:wiki`
# (unit and Town Hall art, from the community wiki). Absent, the API-sourced icons
# fall back to Supercell's CDN and the wiki-sourced ones render nothing at all, which
# is the layout the app had before they existed.
web/public/coc/
.env
.env.local
# SQLite auth database (DATABASE_PATH, default ./data/coc.db) — real accounts.
data/
*.log
.DS_Store
.vite/

# Deploy state, written by deploy/update.sh on the host it runs on. Both describe
# one machine's history rather than the code, so committing either would mean one
# host's rollback target following the repo onto another.
#   .deploy-last-good-sha — the last commit that deployed and answered a health check
#   .deploy-hold          — present while a rollback is holding this host back
.deploy-last-good-sha
.deploy-hold

# The snapshot update.sh takes of web/dist before a build, so a failed build or a
# failed health check has something known-good to put back. Removed on success.
web/dist.prev-*/

# Claude Code. `.claude/settings.json` IS tracked, but it is a model pin
# (`sonnet`), not a permission policy — permissions still come top-down from
# `~/.claude/settings.json` per `~/repos/CLAUDE.md`. This comment previously
# claimed a tracked settings.json existed and called it the shared permission
# policy; neither was true until the model pin was added on 2026-08-06, and even
# now it is narrower than that claim. What stays local is the personal override
# file, which holds whatever grants one machine has accumulated and is nobody
# else's default.
.claude/settings.local.json

# The droplet's address, account name and sudo posture — CLAUDE.md's deploy
# section imports this file rather than stating those specifics inline, because
# this repo gets shared with people who should not receive a live server's
# access details. Local-only; see the file itself for what it holds.
.claude/droplet-access.local.md
