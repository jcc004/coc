# Production .env for the DigitalOcean droplet.
# Copy to /srv/coc/.env on the server and fill in real values. Do NOT commit the
# filled-in .env — it is gitignored.

# CoC API token, bound to the droplet's OUTBOUND address: 192.81.212.182, the
# droplet's own public IP.
#
# NOT the reserved IP (146.190.196.236). That one is inbound only — it is what DNS
# points at and what the certificate is issued for — but traffic *leaving* the
# droplet still egresses from its own public IP, and that is the address Supercell
# sees. A token minted for the reserved IP answers 403 accessDenied.invalidIp on
# every call, naming the address it actually saw.
#
# Confirm it on the droplet:  curl -s https://api.ipify.org
COC_API_TOKEN=

PORT=8787
CACHE_TTL_SECONDS=60

# The address the API binds. Left unset it is 127.0.0.1, which is what you want
# behind Nginx: the app is then genuinely unreachable except through the proxy, so
# it cannot be addressed directly on port 8787 in a way that skips TLS, HSTS, the
# body-size ceiling and the forwarded-header handling.
#
# It used to bind every interface, and the firewall was the only thing preventing
# that. Set this to 0.0.0.0 only if you deliberately want the app exposed without a
# proxy in front, and understand that you are giving up all four of those.
# HOST=127.0.0.1

# Absolute path so the DB location is stable regardless of cwd.
DATABASE_PATH=/srv/coc/server/data/coc.db

# First-boot admin. Set both, start once, then remove ADMIN_PASSWORD.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# The app is served over HTTPS only, so the session cookie must carry the Secure
# flag — without it, any stray plain-http request puts the session token on the
# wire in clear text. NODE_ENV=production turns that on.
#
# Order matters: get the certificate working first, THEN set this. A Secure
# cookie is never sent back over plain http, so setting it too early makes login
# fail silently with nothing useful in the logs.
NODE_ENV=production

# Only needed if you terminate TLS but would rather not set NODE_ENV=production.
# COOKIE_SECURE=true

# Nginx is in front, so the client's real address arrives in a header rather than on
# the socket — the socket address is the proxy's. This says those headers may be
# believed: X-Real-IP, and the LAST hop of X-Forwarded-For, both of which Nginx sets
# from $remote_addr and a caller cannot forge through the proxy.
#
# **Set this whenever Nginx is in front, and never when it is not.** The login rate
# limiter counts failures per client address, and it is the only bound on a request
# that costs the server 40 ms of password hashing whether the account exists or not:
#
#   - unset behind a proxy: every caller looks like the proxy, so they share one
#     bucket, and one person's failures lock out everybody
#   - set with nothing in front: the caller supplies the header, so they choose their
#     own bucket and the limit never fires at all
#
# The app defaults to off, which is the safe direction: without it the socket address
# is used, which is always true even when it is not useful.
TRUST_PROXY=true

# Where deploy/update.sh copies each database backup, in addition to the twenty it
# keeps in ~/coc-backups. Any rsync destination — user@host:path/ or a local mount.
#
# Unset, backups exist only on this droplet, which protects against a bad migration
# and against nothing else: losing the droplet loses the accounts and the whole card
# season with them. The backup contains password hashes, so send it somewhere you
# would be comfortable storing those.
#
# A failure here warns and lets the deploy continue — an unreachable backup host is
# not a reason to stop shipping.
# BACKUP_REMOTE=backup@example.com:/srv/coc-backups/
