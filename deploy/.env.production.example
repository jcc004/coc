# Production .env for the DigitalOcean droplet (146.190.196.236).
# Copy to ~/coc/.env on the server and fill in real values. Do NOT commit the
# filled-in .env — it is gitignored.

# CoC API token created for the DROPLET's IP (146.190.196.236). The token is
# bound to that IP; a token minted for any other IP returns 403 accessDenied.
COC_API_TOKEN=

PORT=8787
CACHE_TTL_SECONDS=60

# Absolute path so the DB location is stable regardless of cwd.
DATABASE_PATH=/home/jcc/coc/server/data/coc.db

# First-boot admin. Set both, start once, then remove ADMIN_PASSWORD.
ADMIN_EMAIL=john@crighton.net
ADMIN_PASSWORD=

# IP-only over HTTP: leave NODE_ENV and COOKIE_SECURE UNSET. Setting
# NODE_ENV=production turns on the Secure cookie flag, which a browser will
# never send back over plain http — login would silently fail. Switch these on
# only once the app is behind HTTPS.
# NODE_ENV=
# COOKIE_SECURE=
