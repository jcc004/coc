# Production .env for the DigitalOcean droplet.
# Copy to /srv/coc/.env on the server and fill in real values. Do NOT commit the
# filled-in .env — it is gitignored.

# CoC API token, bound to the droplet's OUTBOUND address: 192.81.212.182, the
# droplet's own public IP.
#
# NOT the reserved IP (146.190.196.236). That one is inbound only — it is what DNS
# points at and what the certificate is issued for — but traffic *leaving* the
# droplet still egresses from its own public IP, and that is the address Supercell
# sees. A token minted for the reserved IP answers 403 accessDenied.invalidIp on
# every call, naming the address it actually saw.
#
# Confirm it on the droplet:  curl -s https://api.ipify.org
COC_API_TOKEN=

PORT=8787
CACHE_TTL_SECONDS=60

# Absolute path so the DB location is stable regardless of cwd.
DATABASE_PATH=/srv/coc/server/data/coc.db

# First-boot admin. Set both, start once, then remove ADMIN_PASSWORD.
ADMIN_EMAIL=john@crighton.net
ADMIN_PASSWORD=

# The app is served over HTTPS only, so the session cookie must carry the Secure
# flag — without it, any stray plain-http request puts the session token on the
# wire in clear text. NODE_ENV=production turns that on.
#
# Order matters: get the certificate working first, THEN set this. A Secure
# cookie is never sent back over plain http, so setting it too early makes login
# fail silently with nothing useful in the logs.
NODE_ENV=production

# Only needed if you terminate TLS but would rather not set NODE_ENV=production.
# COOKIE_SECURE=true
